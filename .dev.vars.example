# ============================================================
# Rahma École Française - Clés API pour notifications réelles
# Copier ce fichier en ".dev.vars" (local) et remplir les clés.
# En production : gsk hosted secret_put --name XXX --value "..."
# ============================================================

# ---- EMAIL (Resend - gratuit 100 emails/jour) ----
# Créer un compte sur https://resend.com → API Keys → Create
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- SMS (Twilio - payant, ~0.08 USD/SMS vers la Tunisie) ----
# Créer un compte sur https://www.twilio.com/console
TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM=+1xxxxxxxxxx
