# Copier ce fichier vers .dev.vars (gitignoré) et remplir les valeurs.
# En production : npx wrangler pages secret put <NOM> (ou gsk hosted secret_put)

# ── Email (Resend) ── ACTIF ✓
# https://resend.com/api-keys
# ⚠️ Mode test : expéditeur onboarding@resend.dev → livraison uniquement vers
# l'adresse du compte Resend. Vérifier un domaine sur resend.com/domains
# puis renseigner RESEND_FROM ci-dessous.
RESEND_API_KEY=re_xxxxxxxxxxxx
# Expéditeur réel (facultatif). Sans lui, l'envoi reste limité à l'adresse du compte Resend.
# Les invitations F75 ne partent pas sans un expéditeur vérifié.
# RESEND_FROM=no-reply@mon-ecole.tn

# ── SMS (Twilio) ── ACTIF ✓
# Console : https://console.twilio.com
# ⚠️ Compte Trial : livraison uniquement vers les numéros vérifiés
# (Console → Phone Numbers → Verified Caller IDs).
TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM=+1xxxxxxxxxx

# ── Telegram (alternative SMS 100% gratuite, optionnel) ──
# 1. Telegram → @BotFather → /newbot → copier le token
# 2. Redémarrer puis Admin → Notifications → "Reconfigurer le webhook"
# 3. Les parents envoient leur numéro de téléphone au bot pour se lier
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optionnel : chat_id Telegram (ou plusieurs, séparés par des virgules) recevant les alertes de monitoring (Supabase inaccessible).
# Sinon, les alertes vont aux comptes admin dont le téléphone est lié au bot Telegram.
TELEGRAM_ADMIN_CHAT_ID=

# ── Supabase (OBLIGATOIRE) ── aucune valeur par défaut dans le code
# Project Settings → API → service_role (secret). ⚠️ À RÉGÉNÉRER si elle a déjà été exposée.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOi...
# Secret de signature des sessions : openssl rand -hex 32
JWT_SECRET=remplacer-par-64-caracteres-hexadecimaux-aleatoires

# ── Connexion Google (optionnel) ── Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web)
# URI de redirection autorisée : https://<votre-domaine>/api/auth/google/callback (et http://localhost:3000/api/auth/google/callback en local)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx

# Génération IA (fiches/quiz) — clé serveur uniquement. OPENAI_BASE_URL optionnel (proxy compatible OpenAI).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-mini

# Paiement en ligne Konnect (https://konnect.network) — sandbox | production
KONNECT_API_KEY=
KONNECT_WALLET_ID=
KONNECT_ENV=sandbox

# Environnement : production (défaut) | test | staging — affiche un bandeau "ENVIRONNEMENT DE TEST" et est renvoyé par /api/health
APP_ENV=production

# F63 : chiffrement des clés d'accès des établissements (32+ caractères aléatoires). Ne changez JAMAIS cette valeur après avoir enregistré des établissements.
TENANT_SECRET=changez-moi-32-caracteres-minimum-aleatoires

# Moteur IA alternatif (facultatif) — toute API compatible OpenAI ; utilisé automatiquement si le moteur principal échoue (quota, panne), ou au choix dans le tuteur.
# Exemples : Groq https://api.groq.com/openai/v1 (llama-3.3-70b-versatile) · Mistral https://api.mistral.ai/v1 (mistral-small-latest) · DeepSeek https://api.deepseek.com/v1 (deepseek-chat) · Gemini https://generativelanguage.googleapis.com/v1beta/openai (gemini-2.0-flash)
AI_ALT_API_KEY=
AI_ALT_BASE_URL=https://api.groq.com/openai/v1
AI_ALT_MODEL=llama-3.3-70b-versatile
