{
  "name": "webapp",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts_gen_install_sql.mjs && vite build",
    "preview": "wrangler pages dev",
    "deploy": "npm run build && wrangler pages deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "test:seed": "node tests/seed.test.mjs",
    "gen:sql": "node scripts_gen_install_sql.mjs",
    "test:unit": "vitest run",
    "test:monitoring": "vitest run tests/monitoring.test.ts",
    "logs:tail": "bash scripts/monitoring/tail-logs.sh",
    "logs:analyze": "node scripts/monitoring/analyze-logs.mjs"
  },
  "dependencies": {
    "hono": "^4.12.27",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@hono/vite-build": "^1.2.0",
    "@hono/vite-dev-server": "^0.25.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "globals": "^15.15.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.3.5",
    "vitest": "^2.1.9",
    "wrangler": "^4.4.0"
  }
}
