{
  "name": "webapp",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts_gen_install_sql.mjs && vite build",
    "preview": "wrangler pages dev",
    "deploy": "npm run build && wrangler pages deploy dist --project-name rahma-academy --branch main",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "test:seed": "node tests/seed.test.mjs",
    "gen:sql": "node scripts_gen_install_sql.mjs",
    "test:unit": "vitest run",
    "test:monitoring": "vitest run tests/monitoring.test.ts",
    "logs:tail": "bash scripts/monitoring/tail-logs.sh",
    "logs:analyze": "node scripts/monitoring/analyze-logs.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:inline": "node scripts/inline-handlers.mjs",
    "lint:inline:update": "node scripts/inline-handlers.mjs --update",
    "lint:inline:list": "node scripts/inline-handlers.mjs --list",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"public/static/*.js\" \"scripts/**/*.mjs\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"public/static/*.js\" \"scripts/**/*.mjs\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.tests.json",
    "check": "npm run typecheck && npm run lint && npm run lint:inline && npm run test:unit && npm run build",
    "routes:update": "node scripts/routes-snapshot.mjs",
    "test:routes": "vitest run tests/routes.test.ts",
    "deploy:prod": "npm run build && wrangler pages deploy dist --project-name rahma-academy --branch main"
  },
  "dependencies": {
    "hono": "^4.12.27",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@hono/vite-build": "^1.2.0",
    "@hono/vite-dev-server": "^0.25.2",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "globals": "^15.15.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.3.5",
    "vitest": "^2.1.9",
    "wrangler": "^4.4.0"
  }
}
