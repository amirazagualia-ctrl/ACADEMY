{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Nom du projet Cloudflare Pages (= destination de `wrangler pages deploy`).
  // Aligné sur meta_info.cloudflare_project_name : ne pas remettre "webapp",
  // sinon un déploiement sans --project-name créerait un projet « webapp ».
  "name": "rahma-academy",
  "compatibility_date": "2026-04-26",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": [
    "nodejs_compat"
  ]
  // "vars": {
