# Copier en .env.monitoring (gitignoré). Utilisé par docker-compose.monitoring.yml et les scripts scripts/monitoring/*.
# --- Cloudflare (wrangler tail) ---
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
PROJECT=webapp
ENVIRONMENT=production
# --- Application (Grafana → /api/admin/metrics) ---
RAHMA_API_URL=https://rahma-academy.pages.dev
RAHMA_ADMIN_TOKEN=            # JWT d'un compte admin (Paramètres → Mon compte → Jeton API) — à renouveler
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me
# --- Alertes (analyse des logs) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
SLACK_WEBHOOK_URL=
RESEND_API_KEY=
ALERT_EMAIL_FROM=alerts@rahma-academy.tn
ALERT_EMAIL_TO=
ALERT_WEBHOOK_URL=
ALERT_COOLDOWN_MS=900000
# Seuils d'anomalies (fenêtre 5 min)
T_ERRORS_5XX=5
T_ERROR_RATE=0.05
T_P95_MS=3000
T_TRAFFIC_X=4
T_AUTH_FAIL=20
# --- Export longue durée : r2 | s3 | vide ---
LOG_EXPORT=
R2_ACCOUNT_ID=
R2_BUCKET=rahma-logs
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=eu-west-3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
